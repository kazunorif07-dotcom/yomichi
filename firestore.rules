rules_version = '2';
// ヨミチのデータベースのルール（誰が何を読めて、何を書けるか）
//   ・読めるのはログインした人だけ
//   ・プロフィールと投稿は、本人しか作れない・消せない（管理者は問題のある投稿を消せる）
//   ・他人の投稿で変えられるのは「いいね数」「コメント数」を1ずつ増減することだけ
//   ・ブロックされた人は、ブロックした人の投稿にコメント・いいね・フォローができない
//   ・通報は誰でも送れるが、読めるのは管理者だけ
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function shortText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    // 管理者：admins コレクションに自分のユーザーIDの文書がある人（Firebaseの画面から登録する）
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // owner さんが、今ログインしている人をブロックしているか
    function blockedBy(owner) { return exists(/databases/$(database)/documents/users/$(owner)/blocks/$(request.auth.uid)); }
    function postOwner(postId) { return get(/databases/$(database)/documents/posts/$(postId)).data.uid; }

    // 管理者の一覧（自分が管理者かどうかだけ確認できる。書き込みはFirebaseの画面からのみ）
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // プロフィール（名前・連続日数・読了冊数・知の版図）
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid) && shortText(request.resource.data.name, 30);
      allow delete: if isMe(uid);

      // ブロックした相手の一覧（本人しか見られない）
      match /blocks/{target} {
        allow read, write: if isMe(uid);
      }
    }

    // フォロー（ID は「フォローする人のID_される人のID」）
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && !blockedBy(request.resource.data.to);
      // フォローをやめる（自分から）、またはフォロワーを外す（ブロックしたとき）
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // 読書記録の投稿
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && shortText(request.resource.data.book.title, 200);
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if signedIn()
        && !blockedBy(resource.data.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
        && request.resource.data.likeCount >= 0 && request.resource.data.commentCount >= 0
        && math.abs(request.resource.data.likeCount - resource.data.likeCount) <= 1
        && math.abs(request.resource.data.commentCount - resource.data.commentCount) <= 1;

      // いいね（ID は いいねした人のID）
      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isMe(uid) && !blockedBy(postOwner(postId));
        allow delete: if isMe(uid);
      }

      // コメント（300文字まで。消せるのは書いた本人・投稿者・管理者）
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && shortText(request.resource.data.text, 300)
          && !blockedBy(postOwner(postId));
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
          || postOwner(postId) == request.auth.uid
          || isAdmin());
      }
    }

    // 通報（送るのは誰でも。読む・片付けるのは管理者だけ）
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.type in ['post', 'comment', 'user']
        && shortText(request.resource.data.reason, 40)
        && (!('note' in request.resource.data) || request.resource.data.note.size() <= 300);
      allow read, delete: if isAdmin();
    }
  }
}
